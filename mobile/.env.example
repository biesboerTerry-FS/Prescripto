# Backend API. Use your computer's LAN IP on a physical phone, 10.0.2.2 for the
# Android emulator, or localhost for the iOS simulator.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth client IDs (optional). Leave all empty to use the demo Google button.
#
# For Expo Go / development builds with expo-auth-session, create a
# "Web application" OAuth client in Google Cloud Console and add the redirect URI
# printed in the Metro logs when you press the Google sign-in button
# (usually https://auth.expo.io/@your-username/prescripto/auth).
#
# For production standalone builds you can also create iOS and Android OAuth
# clients and add their IDs here. The backend GOOGLE_CLIENT_ID accepts a
# comma-separated list so it can verify ID tokens from any of these clients.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
