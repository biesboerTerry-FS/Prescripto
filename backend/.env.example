PORT=3000
# Public URL of this API. Seeded doctor photos are served from
# <PUBLIC_API_URL>/static/doctors. Set to your Render URL before seeding prod.
PUBLIC_API_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
ADMIN_EMAIL=admin@prescripto.com
ADMIN_PASSWORD=change-me
# JWT (server-signed tokens; access tokens expire after this duration)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins in production, e.g.
# CORS_ORIGIN=https://prescripto.vercel.app,https://prescripto-admin.vercel.app
CORS_ORIGIN=
# Google sign-in (OAuth). Create one or more OAuth clients in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# "Web application" for the patient site and Expo Go; "iOS" / "Android" for native builds.
# Comma-separated list of client IDs that the backend will accept ID tokens from.
GOOGLE_CLIENT_ID=
# Clerk patient auth bridge (frontend/mobile). Leave admin/doctor auth unchanged.
CLERK_SECRET_KEY=
# Stripe payments (optional — leave empty for free-booking demo mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
